{
  "name": "otserver",
  "version": "1.0.0",
  "description": "OTserver industrial asset inventory and discovery platform",
  "homepage": "https://otserver.org",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "node --no-deprecation node_modules/next/dist/bin/next build --webpack",
    "dev": "node --no-deprecation node_modules/next/dist/bin/next dev",
    "generate:importmap": "node --no-deprecation node_modules/payload/bin.js generate:importmap",
    "generate:types": "node --no-deprecation node_modules/payload/bin.js generate:types",
    "lint": "node --no-deprecation node_modules/eslint/bin/eslint.js .",
    "payload": "node --no-deprecation node_modules/payload/bin.js",
    "start": "node --no-deprecation node_modules/next/dist/bin/next start",
    "worker:imports": "cross-env OTSERVER_WORKER_MODE=external node --no-deprecation --import tsx src/worker.ts imports",
    "worker:maintenance": "cross-env OTSERVER_WORKER_MODE=external node --no-deprecation --import tsx src/worker.ts maintenance",
    "migrate": "node --no-deprecation node_modules/payload/bin.js migrate",
    "migrate:status": "node --no-deprecation node_modules/payload/bin.js migrate:status",
    "check:generated": "node scripts/check-generated.mjs",
    "test": "pnpm run test:int",
    "test:container": "sh tests/container-bootstrap.sh",
    "test:safety": "bash tests/check-test-safety.sh",
    "test:otter-client": "cargo build --locked --no-default-features --manifest-path otserver-otter/Cargo.toml && cross-env OTTER_CLIENT_BIN=otserver-otter/target/debug/otserver-otter OTSERVER_VULNERABILITY_FEEDS=off pnpm test:int tests/int/otter-client.int.spec.ts",
    "test:coverage": "pnpm run test:coverage:app",
    "test:coverage:app": "pnpm run test:safety && bash tests/run-vitest.sh --coverage",
    "test:int": "pnpm run test:safety && bash tests/run-vitest.sh"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "@xyflow/react": "^12.12.0",
    "croner": "11.0.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.14.2",
    "lucene-query-parser": "^1.2.0",
    "next": "^16.4.3",
    "payload": "3.90.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "saxes": "6.0.0",
    "stream-json": "3.7.0",
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "5.0.0",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.33.0"
}
