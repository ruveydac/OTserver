{
  "name": "otserver",
  "version": "1.0.0",
  "description": "OTserver industrial asset inventory and discovery platform",
  "homepage": "https://otserver.org",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "worker:imports": "cross-env NODE_OPTIONS=--no-deprecation tsx src/worker.ts imports",
    "worker:maintenance": "cross-env NODE_OPTIONS=--no-deprecation tsx src/worker.ts maintenance",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "benchmark:capacity": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/benchmark-capacity.ts",
    "check:generated": "node scripts/check-generated.mjs",
    "test": "pnpm run test:int",
    "test:container": "sh tests/container-bootstrap.sh",
    "test:coverage": "pnpm run test:coverage:app",
    "test:coverage:app": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config=vitest.config.mts --coverage",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config=vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "@xyflow/react": "^12.11.3",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.2",
    "lucene-query-parser": "^1.2.0",
    "next": "16.3.4",
    "payload": "3.90.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "saxes": "6.0.0",
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "5.0.0",
    "dotenv": "16.4.7",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.33.0"
}
