{
  "name": "otserver",
  "version": "1.0.0",
  "description": "OTserver industrial asset inventory and discovery platform",
  "homepage": "https://otserver.org",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int",
    "test:coverage": "pnpm run test:coverage:app && pnpm run test:coverage:scanner",
    "test:coverage:app": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config=vitest.config.mts --coverage",
    "test:coverage:scanner": "cd scanner && cargo llvm-cov --lib --fail-under-lines 90 --summary-only -- --test-threads=1",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config=vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.87.1",
    "@payloadcms/next": "3.87.1",
    "@payloadcms/ui": "3.87.1",
    "@xyflow/react": "^12.11.3",
    "cross-env": "^7.0.3",
    "d3-force": "^3.0.0",
    "graphql": "^16.8.2",
    "lucene-query-parser": "^1.2.0",
    "next": "16.2.11",
    "payload": "3.87.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.0",
    "dotenv": "16.4.7",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "dompurify@<=3.4.11": ">=3.4.12",
      "sharp@<0.35.0": ">=0.35.0",
      "dompurify@<=3.4.10": ">=3.4.11",
      "dompurify@<3.4.9": ">=3.4.9",
      "postcss@<=8.5.11": ">=8.5.12",
      "postcss@<=8.5.22": ">=8.5.23",
      "dompurify@<=3.4.12": ">=3.4.13",
      "postcss@<=8.5.17": ">=8.5.18"
    }
  }
}
