DATABASE_URL=mongodb://127.0.0.1:27017/otserver?replicaSet=rs0&directConnection=true
OTSERVER_SECRET=replace-with-a-long-random-secret
# Required for managed Otter jobs; use HTTPS remotely or http://localhost:3000 for same-host use.
OTSERVER_PUBLIC_URL=https://otserver.example
# Generate with `openssl rand -hex 32`. Keep stable and back it up separately from OTSERVER_SECRET.
OTSERVER_OTTER_ENCRYPTION_KEY=replace-with-64-hex-characters
# Disable online feed downloads in the web process and maintenance workers; offline uploads stay available.
# OTSERVER_VULNERABILITY_FEEDS=off
# OTSERVER_QUEUED_IMPORTS=on
# Set to external only when dedicated worker processes are deployed.
# OTSERVER_WORKER_MODE=external
# Compose passes this to web and worker containers. For pnpm, export it before starting Node.
# Keep heap below the container memory limit to leave room for uploads and native allocations.
# NODE_OPTIONS=--max-old-space-size=2048
