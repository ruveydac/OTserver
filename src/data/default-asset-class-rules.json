{
  "version": 2,
  "classes": [
    {
      "classKey": "plc",
      "priority": 10,
      "rules": [
        {
          "conditions": [
            { "field": "vendor", "regex": "^Siemens(?: AG)?$" },
            { "field": "model", "regex": "(?:SIMATIC\\s*)?S7-(?:1200|1500).*" }
          ]
        },
        {
          "conditions": [
            { "field": "vendor", "regex": "^(?:Rockwell Automation|Allen[- ]Bradley)$" },
            { "field": "model", "regex": "(?:CompactLogix|ControlLogix|MicroLogix).*" }
          ]
        },
        {
          "conditions": [
            { "field": "vendor", "regex": "^Schneider Electric$" },
            { "field": "model", "regex": "(?:Modicon|M221|M241|M251|M340|M580).*" }
          ]
        }
      ]
    },
    {
      "classKey": "hmi",
      "priority": 20,
      "rules": [
        {
          "conditions": [
            { "field": "vendor", "regex": "^Siemens(?: AG)?$" },
            {
              "field": "model",
              "regex": "(?:SIMATIC\\s*)?(?:HMI|Comfort Panel|Basic Panel|Mobile Panel).*"
            }
          ]
        },
        {
          "conditions": [
            { "field": "vendor", "regex": "^(?:Rockwell Automation|Allen[- ]Bradley)$" },
            { "field": "model", "regex": "PanelView.*" }
          ]
        }
      ]
    },
    {
      "classKey": "network-device",
      "priority": 30,
      "rules": [
        {
          "conditions": [
            { "field": "vendor", "regex": "^Cisco(?: Systems)?$" },
            { "field": "model", "regex": "(?:Catalyst|Industrial Ethernet|IE[- ]?\\d+).*" }
          ]
        },
        {
          "conditions": [
            { "field": "vendor", "regex": "^Hirschmann$" },
            { "field": "model", "regex": "(?:RSP|RSPE|MACH|BOBCAT|SPIDER|OCTOPUS).*" }
          ]
        },
        {
          "conditions": [
            { "field": "vendor", "regex": "^Siemens(?: AG)?$" },
            { "field": "model", "regex": "SCALANCE.*" }
          ]
        }
      ]
    }
  ]
}
