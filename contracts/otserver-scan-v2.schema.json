{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otserver.org/contracts/otserver-scan-v2.schema.json",
  "title": "OTserver Scan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "scanner",
    "scan",
    "devices",
    "links",
    "unresolved",
    "warnings",
    "errors"
  ],
  "properties": {
    "format": { "const": "otserver-scan" },
    "schemaVersion": { "const": 2 },
    "scanner": { "$ref": "#/$defs/scanner" },
    "scan": { "$ref": "#/$defs/scan" },
    "devices": { "type": "array", "items": { "$ref": "#/$defs/device" } },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "unresolved": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "npcapVersion": { "type": "string" }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startedAt", "finishedAt", "targets", "interface"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "interface": { "$ref": "#/$defs/interfaceRef" },
        "partial": { "type": "boolean" }
      }
    },
    "interfaceRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "macAddress": { "$ref": "#/$defs/mac" },
        "addresses": { "type": "array", "items": { "type": "string" } }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macAddress",
        "macAddresses",
        "ipAddresses",
        "observations",
        "interfaces",
        "ports"
      ],
      "properties": {
        "macAddress": { "$ref": "#/$defs/mac" },
        "macAddresses": { "type": "array", "items": { "$ref": "#/$defs/mac" } },
        "ipAddresses": { "type": "array", "items": { "type": "string" } },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/observation" }
        },
        "interfaces": { "type": "array", "items": { "$ref": "#/$defs/networkInterface" } },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observedAt", "fields", "raw", "warnings"],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "arp",
            "bacnet",
            "ethernet-ip",
            "lldp",
            "niagara-fox",
            "omron-fins",
            "os-fingerprint",
            "profinet-dcp",
            "s7",
            "snmp",
            "unknown"
          ]
        },
        "observedAt": { "type": "string", "format": "date-time" },
        "ipAddress": { "type": "string" },
        "macAddress": { "$ref": "#/$defs/mac" },
        "fields": { "type": "object", "additionalProperties": true },
        "raw": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "networkInterface": {
      "type": "object",
      "additionalProperties": true,
      "required": ["key", "source"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "macAddress": { "$ref": "#/$defs/mac" },
        "ipAddresses": { "type": "array", "items": { "type": "string" } },
        "adminStatus": { "type": "string" },
        "operStatus": { "type": "string" },
        "speed": { "type": "integer", "minimum": 0 },
        "mtu": { "type": "integer", "minimum": 0 },
        "raw": {}
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": true,
      "required": ["key", "source"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "interfaceKey": { "type": "string" },
        "portId": { "type": "string" },
        "description": { "type": "string" },
        "macAddress": { "$ref": "#/$defs/mac" },
        "vlans": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 4095 } },
        "raw": {}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["macAddress"],
      "properties": {
        "macAddress": { "$ref": "#/$defs/mac" },
        "stationName": { "type": "string" },
        "interfaceKey": { "type": "string" },
        "portId": { "type": "string" },
        "portMac": { "$ref": "#/$defs/mac" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observedAt", "local", "remote", "raw"],
      "properties": {
        "source": { "type": "string", "enum": ["lldp", "profinet-dcp", "snmp", "unknown"] },
        "observedAt": { "type": "string", "format": "date-time" },
        "local": { "$ref": "#/$defs/endpoint" },
        "remote": { "$ref": "#/$defs/endpoint" },
        "raw": {}
      }
    },
    "mac": {
      "type": "string",
      "pattern": "^(?:[0-9A-F]{2}:){5}[0-9A-F]{2}$"
    }
  }
}
