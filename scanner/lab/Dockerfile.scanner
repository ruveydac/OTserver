FROM rust:1.89-bookworm AS build
WORKDIR /src
COPY scanner/Cargo.toml scanner/Cargo.lock ./
COPY scanner/build.rs ./
COPY scanner/src ./src
RUN cargo build --locked --release

FROM python:3.12-slim-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends libssl3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/otserver-scanner /usr/local/bin/
COPY scanner/lab/verify.py /lab/
ENTRYPOINT ["python3", "/lab/verify.py"]
