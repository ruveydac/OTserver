FROM python:3.12-slim-bookworm
RUN pip install --no-cache-dir \
      python-snap7==2.0.2 \
      scapy==2.6.1 \
      snmpsim==1.2.2 \
      pysmi==1.6.2 \
      cryptography==45.0.7
COPY devices/siemens.py /lab/siemens.py
COPY devices/snmp-data /lab/snmp-data
RUN chmod -R a+rX /lab
ENTRYPOINT ["python3", "/lab/siemens.py"]
